{
  "name": "outfit-studio-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~57.0.28",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.26",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "posthog-react-native": "^4.83.0",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.15.1",
    "react-native-purchases-ui": "10.15.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-redux": "^9.3.0",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|use-intl|intl-messageformat|@formatjs/.*|@revenuecat/.*|icu-minify|react-redux|@reduxjs/.*|redux|immer|reselect))"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../src/$1",
      "^@/(.*)$": [
        "<rootDir>/src/$1",
        "<rootDir>/../src/$1"
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test-utils/setup.ts"
    ]
  }
}
