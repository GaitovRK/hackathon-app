{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "pnpm": "10.6.5",
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3000" }
    },
    "preview": {
      "distribution": "internal",
      "pnpm": "10.6.5",
      "env": { "EXPO_PUBLIC_API_URL": "https://outfit-studio-orpin.vercel.app" }
    },
    "production": {
      "pnpm": "10.6.5",
      "env": { "EXPO_PUBLIC_API_URL": "https://outfit-studio-orpin.vercel.app" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
