{
  "expo": {
    "name": "Opaline",
    "slug": "outfit-studio",
    "scheme": "outfitstudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.gaitovrk.outfitstudio",
      "appleTeamId": "4Z7HNGC242",
      "buildNumber": "6",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "tr"
        ]
      }
    },
    "android": {
      "package": "com.gaitovlabs.opaline",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/icon-foreground.png",
        "backgroundImage": "./assets/android/icon-background.png",
        "monochromeImage": "./assets/android/icon-monochrome.png"
      },
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Opaline uses your photos to pick the outfits to put on a model.",
          "cameraPermission": "Opaline uses the camera to photograph outfits to put on a model.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Opaline uses your photos to pick the outfits to put on a model.",
          "savePhotosPermission": "Opaline saves the generated outfit photos to your library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f7f6f3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0c0a09"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/cormorant-garamond/600SemiBold/CormorantGaramond_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/cormorant-garamond/600SemiBold_Italic/CormorantGaramond_600SemiBold_Italic.ttf"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "./plugins/withAlternateAppIcons",
        {
          "icons": {
            "AppIcon-Folded": "./assets/icon-folded.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidFreeOrientation"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2111b0c2-d64c-4bd0-a8f6-fd00588f5e7c"
      }
    },
    "owner": "gaitovrk"
  }
}
