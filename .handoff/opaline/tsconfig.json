{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      // Code shared with the web app (types, generation rules, i18n catalogs) lives in ../src.
      "@shared/*": ["../src/*"],
      // Shared files import each other with "@/"; mobile files win, then the web app's src.
      "@/*": ["./src/*", "../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
