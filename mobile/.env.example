# Backend base URL for dev builds (no trailing slash). Release builds (TestFlight / App Store)
# ignore it and always call https://flick-api.gaitovlabs.com (src/services/api/config.ts).
EXPO_PUBLIC_API_URL=http://localhost:3000
# RevenueCat public SDK keys; leave empty to skip Purchases.configure.
# Test Store keys (test_…) work in dev builds only. For release builds put the App Store key (appl_…)
# in mobile/.env.production (gitignored): Xcode Release bundles load it over this file.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
