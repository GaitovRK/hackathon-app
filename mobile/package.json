{
  "name": "hackathon-app-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~57.0.28",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.15.1",
    "react-native-purchases-ui": "10.15.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@revenuecat/.*|react-redux|@reduxjs/.*|redux|immer|reselect))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test-utils/setup.ts"
    ]
  }
}
